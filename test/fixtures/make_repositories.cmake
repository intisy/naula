cmake_minimum_required(VERSION 3.19)

if(NOT DEFINED ROOT)
    message(FATAL_ERROR "pass -DROOT=<folder to build the fixture repositories in>")
endif()

file(REMOVE_RECURSE "${ROOT}")
file(MAKE_DIRECTORY "${ROOT}/home")
set(ENV{HOME} "${ROOT}/home")
set(ENV{USERPROFILE} "${ROOT}/home")
set(ENV{GIT_CONFIG_GLOBAL} "${ROOT}/home/gitconfig")
set(ENV{GIT_CONFIG_NOSYSTEM} "1")
set(ENV{GIT_AUTHOR_NAME} "Fixture")
set(ENV{GIT_AUTHOR_EMAIL} "fixture@example.invalid")
set(ENV{GIT_COMMITTER_NAME} "Fixture")
set(ENV{GIT_COMMITTER_EMAIL} "fixture@example.invalid")

set(clock 1700000000)

function(git directory)
    execute_process(COMMAND git ${ARGN} WORKING_DIRECTORY "${directory}" RESULT_VARIABLE result
                    OUTPUT_QUIET ERROR_VARIABLE problem)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "git ${ARGN} in ${directory} exited ${result}: ${problem}")
    endif()
endfunction()

function(commit directory name)
    math(EXPR next "${clock} + 60")
    set(clock ${next} PARENT_SCOPE)
    set(ENV{GIT_AUTHOR_DATE} "${next} +0000")
    set(ENV{GIT_COMMITTER_DATE} "${next} +0000")
    file(WRITE "${directory}/${name}.txt" "${name}\n")
    git("${directory}" add "${name}.txt")
    git("${directory}" commit --quiet -m "${name}")
endfunction()

function(initialise directory)
    file(MAKE_DIRECTORY "${directory}")
    git("${directory}" init --quiet -b main ${ARGN})
endfunction()

set(linear "${ROOT}/linear")
initialise("${linear}")
commit("${linear}" c1)
commit("${linear}" c2)
git("${linear}" branch previous)
commit("${linear}" c3)
git("${linear}" checkout --quiet --orphan rewritten)
commit("${linear}" r1)
commit("${linear}" r2)
git("${linear}" checkout --quiet main)

set(merged "${ROOT}/merged")
initialise("${merged}")
commit("${merged}" a1)
commit("${merged}" a2)
git("${merged}" checkout --quiet --orphan second)
git("${merged}" rm -rf --quiet .)
commit("${merged}" x1)
git("${merged}" checkout --quiet main)
math(EXPR clock "${clock} + 60")
set(ENV{GIT_AUTHOR_DATE} "${clock} +0000")
set(ENV{GIT_COMMITTER_DATE} "${clock} +0000")
git("${merged}" merge --quiet --no-ff --allow-unrelated-histories -m merge second)

initialise("${ROOT}/wide" --object-format=sha256)
commit("${ROOT}/wide" w1)

initialise("${ROOT}/remote")
commit("${ROOT}/remote" f1)
commit("${ROOT}/remote" f2)
git("${ROOT}/remote" config uploadpack.allowFilter true)
initialise("${ROOT}/fetched")
