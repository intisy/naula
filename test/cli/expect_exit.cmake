if(DEFINED SEARCH_PATH)
    set(ENV{PATH} "${SEARCH_PATH}")
endif()
string(REPLACE "|" ";" arguments "${ARGUMENTS}")
execute_process(COMMAND "${PROGRAM}" ${arguments} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT "${result}" STREQUAL "${EXPECTED}")
    message(FATAL_ERROR "naula ${arguments} exited ${result}, expected ${EXPECTED}\n${output}${errors}")
endif()
if(DEFINED HAS AND NOT "${output}${errors}" MATCHES "${HAS}")
    message(FATAL_ERROR "naula ${arguments} printed nothing matching ${HAS}\n${output}${errors}")
endif()
if(DEFINED HAS_ALSO AND NOT "${output}${errors}" MATCHES "${HAS_ALSO}")
    message(FATAL_ERROR "naula ${arguments} printed nothing matching ${HAS_ALSO}\n${output}${errors}")
endif()
